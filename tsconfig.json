{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*", "./client/src/*"],
      "@workspace/db": ["./lib/db", "./shared/db"],
      "@workspace/api-zod": ["./shared/zod", "./shared"],
      "@workspace/api-client-react": ["./client/src", "./src"]
    }
  },
  "include": [
    "src/**/*",
    "client/**/*",
    "api/**/*",
    "lib/**/*",
    "shared/**/*",
    "*.ts",
    "*.tsx",
    "*.js",
    "*.jsx"
  ]
}
